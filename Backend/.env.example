# Copy to .env (never commit .env)
DATABASE_URL=sqlite:///./coldchain.db      # prod: postgresql://user:pass@host/db  (Neon / Supabase)
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000          # frontend URL(s), comma separated
AUTO_CREATE_TABLES=1                        # set 0 in prod and use `alembic upgrade head`
